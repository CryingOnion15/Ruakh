#pragma kernel CSDetectEdges
#pragma kernel CSSpreadHalo

// Built-in depth texture (provided by Unity)
Texture2D<float> _CameraDepthTexture;
SamplerState sampler_CameraDepthTexture;

// Output textures
RWTexture2D<float> _Result;       // For detect edges or final halo
RWTexture2D<float> _EdgeMask;     // Input mask for spread pass

// Parameters
float _Threshold;
float _Radius;
float _Intensity;
float _CameraNear;
float _CameraFar;


// ---------- Linearize Depth ----------
// float Linear01Depth(float z)
// {
//     return 1.0 / (_CameraFar / _CameraNear - z * (_CameraFar / _CameraNear - 1.0));
// }


// ---------- First Pass: Edge Detection ----------
[numthreads(8,8,1)]
void CSDetectEdges(uint3 id : SV_DispatchThreadID)
{
    // uint width, height;
    // _Result.GetDimensions(width, height);
    // if (id.x >= width || id.y >= height) return;

    uint width, height;
    _Result.GetDimensions(width, height);
    float2 uv = (id.xy + 0.5) / float2(width, height);
    float rawDepth = _CameraDepthTexture.SampleLevel(sampler_CameraDepthTexture, uv, 0);
    //float centerDepth = Linear01Depth(rawDepth);


    // bool isEdge = false;
    // int2 offsets[4] = { int2(1,0), int2(-1,0), int2(0,1), int2(0,-1) };

    // for (int i = 0; i < 4; i++)
    // {
    //     int2 n = int2(id.xy) + offsets[i];
    //     if (n.x >= 0 && n.x < width && n.y >= 0 && n.y < height)
    //     {
    //         float neighborDepth = Linear01Depth(_CameraDepthTexture.Load(int3(n,0)));
    //         if (abs(neighborDepth - centerDepth) > _Threshold)
    //         {
    //             isEdge = true;
    //             break;
    //         }
    //     }
    // }

    //_Result[id.xy] = isEdge ? 1.0 : 0.0;
    _Result[id.xy] = rawDepth;
}

// ---------- Second Pass: Halo Spread ----------
[numthreads(8,8,1)]
void CSSpreadHalo(uint3 id : SV_DispatchThreadID)
{
    uint width, height;
    _Result.GetDimensions(width, height);
    if (id.x >= width || id.y >= height) return;

    float halo = 0.0;

    int radiusInt = int(_Radius);
    for (int dy = -radiusInt; dy <= radiusInt; dy++)
    {
        for (int dx = -radiusInt; dx <= radiusInt; dx++)
        {
            int2 n = int2(id.xy) + int2(dx, dy);
            if (n.x < 0 || n.x >= width || n.y < 0 || n.y >= height) continue;

            float dist = length(float2(dx, dy));
            if (dist > _Radius) continue;

            float mask = _EdgeMask[n];
            halo = max(halo, mask * (1.0 - dist/_Radius) * _Intensity);
        }
    }

    _Result[id.xy] = 0.0;
    //_Result[id.xy] = halo;
}

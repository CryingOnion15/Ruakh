// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel CSParticleMove
#pragma kernel SpawnParticles

struct LightParticle
{
    float3 rotationMatRow1;
    float3 rotationMatRow2;
    float3 rotationMatRow3;
    float3 position;
    float3 startPosition;
    float3 velocity;
    float theta;
    uint state; // 0 = drift, 1 = captured, 2 = midpoint, 3 = dead/invisable
};

struct ParticleMidpoint {
    float3 midpoint;
    uint triIndex;
};

// Read Write Structured buffer that will store individual particle data.
RWStructuredBuffer<LightParticle> particleBuffer;
RWStructuredBuffer<ParticleMidpoint> midpointsBuffer;
RWStructuredBuffer<uint> lightWatersColors;

// Particle movement variables
float deltaTime;
float driftSpeed;
float particleSize;
float halfBoundsX;
float halfBoundsY;
float orbitSize;
float followSpeed;
float captureRadius;

// Random Seed
uint randomSeed;

// Vectors
float3 playerLoc;
float3 upVector;
float3 rightVector;

// Control
bool captureEnabled;
uint particlesToMidpoint;

// Constants
static const float PI = 3.14159265358979323846;
static const float PHI = (PI / 2);
static const float SINEPHI = sin(PHI);

float random(uint seed, uint salt)
{
    seed ^= salt;
    seed ^= seed >> 17;
    seed *= 0xed5ad4bb;
    seed ^= seed >> 11;
    seed *= 0xac4c1b51;
    seed ^= seed >> 15;
    seed *= 0x31848bab;
    seed ^= seed >> 14;
    return frac(seed / 4294967296.0); // Normalize to [0,1)
}

float3 GetSphericalCoord(float theta, float radius) {
    float x = radius * SINEPHI * cos(theta);
    float y = radius * cos(PHI);
    float z = radius * SINEPHI * sin(theta);
    return float3(x, y, z); 
}

float3 RotateLocation(float3 row1, float3 row2, float3 row3, float3 pos) {
    return float3(
        dot(row1, pos),
        dot(row2, pos),
        dot(row3, pos)
    );
}

void SetRandomParticleVelocity(inout LightParticle particle, uint thread) {
    float theta = random((randomSeed + thread), 48) * PI * 2;
    float3 velX = cos(theta) * rightVector;
    float3 velY = sin(theta) * upVector;

    particle.velocity = velX + velY;
}

void SetRandomParticleAxis(inout LightParticle particle, uint thread) {
    float xTheta = random((randomSeed + thread), 19) * 2 * PI;
    float yTheta = random((randomSeed + thread), 20) * 2 * PI;
    float zTheta = random((randomSeed + thread), 21) * 2 * PI;

    float cosx = cos(xTheta);
    float sinx = sin(xTheta);
    float cosy = cos(yTheta);
    float siny = sin(yTheta);
    float cosz = cos(zTheta);
    float sinz = sin(zTheta);

    particle.rotationMatRow1.x = cosy * cosz;
    particle.rotationMatRow1.y = cosy * -sinz;
    particle.rotationMatRow1.z = siny;

    particle.rotationMatRow2.x = cosx * sinz;
    particle.rotationMatRow2.y = cosx * cosz;
    particle.rotationMatRow2.z = -sinx * cosy;

    particle.rotationMatRow3.x = cosx * -siny * cosz + sinx * sinz;
    particle.rotationMatRow3.y = cosx * -siny * -sinz + sinx * cosz;
    particle.rotationMatRow3.z = cosx * cosy;

    particle.theta = random((randomSeed + thread), 22) * 2 * PI;
}


/****** Movement Functions ******/
void MoveObital(inout LightParticle particle) {
    float3 equatorPos = GetSphericalCoord(particle.theta, orbitSize);
    float3 rotatedPos = RotateLocation(particle.rotationMatRow1, particle.rotationMatRow2, particle.rotationMatRow3, equatorPos);
    float3 direction = normalize((playerLoc + rotatedPos) - particle.position);

    particle.theta += deltaTime;
    particle.position = lerp(particle.position, playerLoc + rotatedPos, 1.0 - exp(-followSpeed * deltaTime));
}

void MoveToMidpoint(uint index, inout LightParticle particle) {
    ParticleMidpoint current = midpointsBuffer[index];
    float3 midpoint = current.midpoint;
    float3 direction = normalize(midpoint - particle.position);

    particle.velocity = direction;
    particle.position += 300 * particle.velocity * deltaTime;
    
    float3 midpointVec = midpoint - particle.position;

    if(dot(midpointVec, midpointVec) <= .2) {
        particle.state = 5;
        
        uint currentColor = lightWatersColors[current.triIndex];
        lightWatersColors[current.triIndex] = currentColor + 1;
    }

}

void MoveDrift(inout LightParticle particle) {
    particle.position += driftSpeed * particle.velocity * deltaTime;

    float dotX = dot(particle.position, rightVector);
    float dotY = dot(particle.position, upVector);

    // Flip the X velocity if it is outside the bounds.
    // Hits the right side of the bound
    if(dotX + particleSize > halfBoundsX) {
        particle.velocity = reflect(particle.velocity, -rightVector);
    }

    // Hits the left side of the bound
    if(dotX - particleSize < -halfBoundsX) {
        particle.velocity = reflect(particle.velocity, rightVector);
    }

    // Flip the Y velocity if it is outside the bounds.
    // Hits the uppper side of the bound.
    if(dotY + particleSize > halfBoundsY) {
        particle.velocity = reflect(particle.velocity, -upVector);
    }

    // Hits the lower side of the bound.
    if(dotY - particleSize < -halfBoundsY) {
       particle.velocity = reflect(particle.velocity, upVector);
    }
}

void MoveToStart(uint index, inout LightParticle particle) {
    float3 direction = normalize(particle.startPosition - particle.position);

    particle.velocity = direction;
    particle.position += 1000 * particle.velocity * deltaTime;
    
    float3 midpointVec = particle.startPosition - particle.position;

    // If the particles is very near the start position.
    if(dot(midpointVec, midpointVec) <= 10) {
        SetRandomParticleVelocity(particle, index);
        particle.state = 2;
    }

}

[numthreads(256,1,1)]
void CSParticleMove (uint3 id : SV_DispatchThreadID)
{
    LightParticle particle = particleBuffer[id.x];

    /**
    0: NONE
    1: Move to start
    2: Drift Movement
    3: Orbital Movement
    4: Midpoint Movement
    5: Completed
    **/
    switch(particle.state) {
        // Start Movement.
        case 1:
            MoveToStart(id.x, particle);
            break;
        // Standard Movement
        case 2:
            float circX = pow(particle.position.x - playerLoc.x, 2);
            float circY = pow(particle.position.y - playerLoc.y, 2);
            float circZ = pow(particle.position.z - playerLoc.z, 2);
            bool isInside = circX + circY + circZ <= captureRadius * captureRadius;

            if(isInside && captureEnabled) {
                // Update the buffer to show the particle is state.
                particle.state = 3;
                MoveObital(particle);
            } else {
                particle.state = 2;
                MoveDrift(particle);
            }
            break;
        // Orbital Movement
        case 3:
            if(id.x < particlesToMidpoint) {
                particle.state = 4;
                MoveToMidpoint(id.x, particle);
            } else {
                MoveObital(particle);
            }
            break;
        // Midpoint Movement
        case 4:
            MoveToMidpoint(id.x, particle);
            break;
    }
        
    particleBuffer[id.x] = particle;
}

// Intialize all particles and move towards the start position/drift.
[numthreads(256,1,1)]
void SpawnParticles (uint3 id : SV_DispatchThreadID)
{
    LightParticle particle = particleBuffer[id.x];
    SetRandomParticleAxis(particle, id.x);
    particle.state = 1;

    particleBuffer[id.x] = particle;
}



